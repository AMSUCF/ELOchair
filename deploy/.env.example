# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public address of ELOchair (DNS must point at this server for HTTPS to work).
ELOCHAIR_DOMAIN=chair.eliterature.org
APP_ORIGIN=https://chair.eliterature.org

# Database password (long and random: openssl rand -base64 32).
POSTGRES_PASSWORD=change-me

# Outgoing mail. Needs an SMTP account allowed to send as the MAIL_FROM address
# (SPF/DKIM on eliterature.org), otherwise magic links land in spam.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://user:password@smtp.example.org:587
MAIL_FROM=ELOchair <no-reply@eliterature.org>
