# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public address of ELOchair (DNS must point at this server for HTTPS to work).
ELOCHAIR_DOMAIN=chair.eliterature.org
APP_ORIGIN=https://chair.eliterature.org

# Database password: long, random, and URL-safe (it is placed in a connection URL).
# Generate with: openssl rand -hex 32   (do not use base64: "/", "+" and "=" break the URL)
POSTGRES_PASSWORD=change-me

# Server secret that keys sign-in codes; keep it out of backups and never reuse it.
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-64-hex-characters

# Outgoing mail. Needs an SMTP account allowed to send as the MAIL_FROM address
# (SPF/DKIM on eliterature.org), otherwise magic links land in spam.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://user:password@smtp.example.org:587
MAIL_FROM=ELOchair <no-reply@eliterature.org>

# Backups (optional: these are the defaults). The backup service dumps the database into
# deploy/backups/ every BACKUP_INTERVAL_MINUTES, and keeps the newest dump of each of the latest
# 48 hours, 14 days, 8 weeks and 12 months that have one. The directory never holds more dumps
# than the sum of the four numbers: 82 with these defaults. 0 turns a tier off.
# See "Backups" in deploy/README.md.
# BACKUP_INTERVAL_MINUTES=60
# BACKUP_KEEP_HOURLY=48
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# BACKUP_KEEP_MONTHLY=12
