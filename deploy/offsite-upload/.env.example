# The offsite uploader's settings. Copy to .env in this directory and fill in, then keep it
# readable by you alone (chmod 600 .env). Never commit .env.
#
# Only the backup-offsite service reads this file. Do not put any of it in deploy/.env: every
# value there is given to the app container, which faces the internet and has no use for a
# bucket key.

# Where the dumps go: remote:bucket/prefix. The remote is named "offsite".
BACKUP_OFFSITE_DEST=offsite:my-elochair-backups/elochair

# The uploader's own key: list and put only (see deploy/backup-offsite.md for the policy).
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
RCLONE_CONFIG_OFFSITE_REGION=us-east-1
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=change-me
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=change-me
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://us-east-1.linodeobjects.com

# Encrypt the dumps before they leave (recommended; section 3 of deploy/backup-offsite.md).
# With these set, the destination above becomes:  BACKUP_OFFSITE_DEST=offsitecrypt:
# RCLONE_CONFIG_OFFSITECRYPT_TYPE=crypt
# RCLONE_CONFIG_OFFSITECRYPT_REMOTE=offsite:my-elochair-backups/elochair
# RCLONE_CONFIG_OFFSITECRYPT_FILENAME_ENCRYPTION=off
# RCLONE_CONFIG_OFFSITECRYPT_PASSWORD=the-obscured-password

# Seconds between rounds, at least 1.
# BACKUP_OFFSITE_INTERVAL=900
