# The offsite pruner's settings. Copy to .env in this directory and fill in.
# Never commit .env, and never put it on the ELOchair server: the point of the pruner is that
# the key that can delete lives on a different machine from the key that can upload.

# The bucket and prefix the server uploads to. If the server encrypts its uploads, this is the
# server's RCLONE_CONFIG_OFFSITECRYPT_REMOTE (the bucket itself), not "offsitecrypt:": the
# pruner works on the stored names and neither needs nor should have the encryption password.
BACKUP_OFFSITE_DEST=offsite:my-backup-bucket/elochair

# The pruner's own key: list and delete only (see deploy/backup-offsite.md for the policy).
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
RCLONE_CONFIG_OFFSITE_REGION=us-east-1
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=change-me
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=change-me
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://us-east-1.linodeobjects.com

# The rolling set to keep. These must be the same four values the server uses for its own
# backups (the defaults are the same on both), or the bucket and the server will disagree.
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# 1 logs what would be deleted and deletes nothing. Start with 1, read the log, then set 0.
OFFSITE_DRY_RUN=1

# Seconds between rounds of the looping service (not used by prune-once).
# BACKUP_OFFSITE_INTERVAL=3600
